From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf contributor <leaf-contributor@users.noreply.github.com>
Date: Sat, 21 Nov 2026 22:58:23 +0000
Subject: [PATCH] Keep player saves ordered after slow IO


diff --git a/net/minecraft/world/level/storage/PlayerDataStorage.java b/net/minecraft/world/level/storage/PlayerDataStorage.java
index 0aeeb1451e96aa6f34976c0edc91599851d53585..dab1fc485e855e6dd6c76713fe34bd912e3a374c 100644
--- a/net/minecraft/world/level/storage/PlayerDataStorage.java
+++ b/net/minecraft/world/level/storage/PlayerDataStorage.java
@@ -92,10 +92,11 @@ public class PlayerDataStorage {
                 break;
             } catch (InterruptedException ignored) {
                 interrupted = true;
-            } catch (java.util.concurrent.ExecutionException
-                     | java.util.concurrent.TimeoutException exception) {
+            } catch (java.util.concurrent.ExecutionException exception) {
                 LOGGER.warn("Failed to save player data for {}", playerName, exception);
-
+                break;
+            } catch (java.util.concurrent.TimeoutException exception) {
+                LOGGER.warn("Still waiting for player data save for {}; keeping the previous save ordered", playerName);
                 String threadDump = "";
                 var threadMXBean = java.lang.management.ManagementFactory.getThreadMXBean();
                 for (var threadInfo : threadMXBean.dumpAllThreads(true, true)) {
@@ -105,8 +106,6 @@ public class PlayerDataStorage {
                     }
                 }
                 LOGGER.warn(threadDump);
-                fut.cancel(true);
-                break;
             }
         }
         synchronized (this) {
